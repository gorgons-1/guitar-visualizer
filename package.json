{
  "name": "guitar-visualizer",
  "productName": "Guitar Visualizer",
  "version": "0.1.17",
  "description": "Interactive guitar fretboard visualizer: scales, chords, arpeggios, tunings, sound and live input.",
  "author": "Paul Hellyer <paul.hellyer1978@outlook.com>",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist": "electron-builder --publish never",
    "release:patch": "npm version patch -m \"Release v%s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"Release v%s\" && git push --follow-tags",
    "release:major": "npm version major -m \"Release v%s\" && git push --follow-tags"
  },
  "build": {
    "appId": "com.paulhellyer.guitarvisualizer",
    "productName": "Guitar Visualizer",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Guitar Visualizer listens to your guitar to show the notes you play."
      }
    },
    "linux": {
      "category": "Audio",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "Paul Hellyer <paul.hellyer1978@outlook.com>",
      "synopsis": "Guitar fretboard visualizer with live input, lessons and chord checking",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://github.com/gorgons-1/guitar-visualizer",
  "desktopName": "guitar-visualizer.desktop"
}
